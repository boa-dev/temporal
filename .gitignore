# Generated by Cargo
# will have compiled files and executables
debug/
target/
tzdata/
.tzdata/

# Include the data debug view
!/crates/provider/src/data/debug

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

.vscode/

# Ignore log files
*.log

# Ignore clangd files
.cache
compile_commands.json

# Generated zoneinfo test data — produced by `mise run zoneinfo:test`
crates/zoneinfo/tests/data/*.json
